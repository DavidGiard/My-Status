@page
@model MyStatus.Pages.Account.LoginModel
@{ ViewData["Title"] = "Sign in"; }
<section class="card account">
    <p class="eyebrow">PRIVATE WORKSPACE</p><h1>Welcome back</h1>
    <p class="muted">Use your work or school Microsoft account. Access is restricted to the configured owner.</p>
    @if (Model.SignInFailed)
    { <p class="notice" role="alert">Microsoft sign-in could not be completed. Use the authorized account or contact the operator to check the app registration and account link.</p> }
    @if (!Model.Configured)
    { <p class="notice" role="status">Microsoft sign-in needs setup. Configure the Entra app registration and owner identity using the instructions in README.md.</p> }
    <form method="post">
        <div asp-validation-summary="All" role="alert"></div>
        <input type="hidden" asp-for="ReturnUrl" />
        <button type="submit" disabled="@(!Model.Configured)">Sign in with Microsoft</button>
    </form>
    <p class="muted">Your password and MFA are managed by Microsoft, not this application. Public registration and local password sign-in are disabled.</p>
</section>

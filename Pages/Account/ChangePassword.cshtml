@page
@model MyStatus.Pages.Account.ChangePasswordModel
@{ ViewData["Title"] = "Change password"; }
<section class="card account">
    <h1>Change password</h1>
    <p class="muted">Use at least 12 characters with uppercase and lowercase letters, a digit, and a symbol.</p>
    <form method="post">
        <div asp-validation-summary="All" role="alert"></div>
        <label asp-for="CurrentPassword">Current password</label>
        <input asp-for="CurrentPassword" autocomplete="current-password" />
        <label asp-for="NewPassword">New password</label>
        <input asp-for="NewPassword" autocomplete="new-password" />
        <label asp-for="ConfirmPassword">Confirm password</label>
        <input asp-for="ConfirmPassword" autocomplete="new-password" />
        <button type="submit">Change password</button>
    </form>
</section>

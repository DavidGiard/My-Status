@page
@model MyStatus.Pages.Account.ForgotPasswordModel
@{ ViewData["Title"] = "Password recovery"; }
<section class="card account">
    <h1>Password recovery</h1>
    @if (Model.Sent)
    {
        <p role="status">If this address belongs to the account, a reset link will be sent. Check your inbox and spam folder. Links expire after 30 minutes. If delivery does not arrive, contact the application operator.</p>
    }
    else
    {
        <form method="post">
            <div asp-validation-summary="All" role="alert"></div>
            <label asp-for="Email"></label><input asp-for="Email" autocomplete="email" required />
            <button type="submit">Request reset link</button>
        </form>
    }
    <a asp-page="/Account/Login">Back to sign in</a>
</section>

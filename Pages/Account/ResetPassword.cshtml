@page
@model MyStatus.Pages.Account.ResetPasswordModel
@{ ViewData["Title"] = "Reset password"; }
<section class="card account">
    <h1>Reset password</h1>
    @if (Model.Done)
    {
        <p role="status">Your password has been reset. <a asp-page="/Account/Login">Sign in</a>.</p>
    }
    else
    {
        <form method="post">
            <div asp-validation-summary="All" role="alert"></div>
            <input type="hidden" asp-for="UserId" /><input type="hidden" asp-for="Code" />
            <label asp-for="Password"></label><input asp-for="Password" autocomplete="new-password" required />
            <label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" autocomplete="new-password" required />
            <p class="muted">At least 12 characters, with upper/lowercase letters, a digit, and a symbol.</p>
            <button type="submit">Reset password</button>
        </form>
        <a asp-page="/Account/ForgotPassword">Request another link</a>
    }
</section>

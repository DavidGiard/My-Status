{
  "ConnectionStrings": {
    "DefaultConnection": "Server=tcp:<sql-server>.database.windows.net,1433;Database=<database>;Authentication=Active Directory Default;Encrypt=True;TrustServerCertificate=False;"
  },
  "Database": { "Provider": "SqlServer" },
  "App": { "PublicUrl": "https://<app-hostname>" },
  "DataProtection": {
    "KeyIdentifier": "https://<vault>.vault.azure.net/keys/<key-name>"
  },
  "AllowedHosts": "<app-hostname>"
}
